rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helpers
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User Profiles
    match /users/{userId} {
      // Users can always read their own profile.
      // Admins can read any profile.
      allow read: if isOwner(userId) || isAdmin();
      
      // Allow creation during registration, but never as an admin
      allow create: if isOwner(userId) && request.resource.data.role != 'admin';
      
      // Only admins can update 'role' or 'approved' status.
      // Users can update their own phone, firstName, etc., but NOT role/approved.
      allow update: if (isOwner(userId) && 
                      !request.resource.data.diff(resource.data).affectedKeys()
                        .hasAny(['role', 'approved']))
                    || isAdmin();
    }

    // Donations
    match /donations/{donationId} {
      allow read: if isAuthenticated();
      
      allow create: if isAuthenticated() && request.resource.data.donorId == request.auth.uid;
      
      allow update: if isAuthenticated() && (
        // Donor can update their own donation (but not donorId)
        (resource.data.donorId == request.auth.uid && 
         request.resource.data.donorId == resource.data.donorId) || 
        
        // NGO can only update status/claimedBy (claiming logic)
        (resource.data.status == 'available' && 
         request.resource.data.status == 'claimed' &&
         request.resource.data.claimedBy == request.auth.uid) ||
         
        // Admin has full control
        isAdmin()
      );
      
      allow delete: if isAdmin() || (isAuthenticated() && resource.data.donorId == request.auth.uid);
    }
  }
}
